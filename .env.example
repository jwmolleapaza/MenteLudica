# ============================================================================
# MENTELÚDICA – CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# Copiar como .env.local para desarrollo local o configurar en Vercel.
# ============================================================================

# --- 1. APLICACIÓN Y DOMINIO ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development" # development | staging | production
NEXT_PUBLIC_BUSINESS_NAME="MenteLúdica"
NEXT_PUBLIC_DEFAULT_CITY="Arequipa"
NEXT_PUBLIC_DEFAULT_COUNTRY="Perú"
NEXT_PUBLIC_WHATSAPP_NUMBER="51900000000"

# --- 2. SUPABASE (BASE DE DATOS, AUTH & STORAGE) ---
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-publica"
# IMPORTANTE: Nunca exponer SERVICE_ROLE_KEY con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-privada"

# --- 3. PASARELAS DE PAGO OFICIALES (PERÚ) ---
# Culqi (Tarjetas, Yape integrado)
NEXT_PUBLIC_CULQI_PUBLIC_KEY=""
CULQI_PRIVATE_KEY=""
CULQI_WEBHOOK_SECRET=""

# Mercado Pago Perú
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Niubiz (Visa / Mastercard Perú)
NIUBIZ_MERCHANT_ID=""
NIUBIZ_USER=""
NIUBIZ_PASSWORD=""
NIUBIZ_ENV="sandbox" # sandbox | prod

# --- 4. ANALÍTICA Y MARKETING DIGITAL ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

